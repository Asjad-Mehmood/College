// Prisma schema: https://pris.ly/d/prisma-schema
// The connection string comes from DB_URL (see prisma.config.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN // Discipline In-Charge
  GATE // Gate staff / proctor
  PRINCIPAL // Read-only viewer
}

enum StudentStatus {
  ACTIVE
  STRUCK_OFF
  GRADUATED
}

enum LateReason {
  TRANSPORT
  TRAFFIC
  MEDICAL
  WEATHER
  NO_EXCUSE
}

enum DisciplineAction {
  VERBAL_WARNING
  WRITTEN_WARNING
  FINE
  PARENT_CALLED
  DETENTION
  PARENT_MEETING
}

enum Schedule {
  SUMMER
  WINTER
}

enum Severity {
  MINOR
  MAJOR
  SEVERE
}

enum ViolationAction {
  VERBAL_WARNING
  WRITTEN_WARNING
  FINE
  PARENT_CALLED
  PARENT_MEETING
  DETENTION
  SUSPENSION
  REFERRED_TO_COMMITTEE
}

enum CaseStatus {
  OPEN
  CLOSED
}

enum TripType {
  STUDY_TOUR
  INDUSTRIAL_VISIT
  SPORTS
  COMPETITION
  RECREATIONAL
  OTHER
}

enum TripStatus {
  OPEN // accepting students
  CLOSED // registration closed, preparing to leave
  DEPARTED // on the trip
  RETURNED
  CANCELLED
}

enum ConsentStatus {
  PENDING
  RECEIVED
  REFUSED
}

enum Shift {
  MORNING
  EVENING
}

enum StudyYear {
  FIRST
  SECOND
}

enum MemberStatus {
  SELECTED
  WAITLIST
  DROPPED
}

enum TrialResult {
  PENDING
  SELECTED
  WAITLIST
  REJECTED
}

enum ParticipantStatus {
  REGISTERED
  WITHDRAWN
}

model Student {
  rollNo       String        @id @map("roll_no") @db.VarChar(20)
  fullName     String        @map("full_name") @db.VarChar(100)
  fatherName   String        @map("father_name") @db.VarChar(100)
  program      String        @db.VarChar(50)
  section      String        @db.VarChar(20)
  studentPhone String?       @map("student_phone") @db.VarChar(20)
  parentPhone  String        @map("parent_phone") @db.VarChar(20)
  photoUrl     String?       @map("photo_url") @db.VarChar(255)
  status       StudentStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  lateRecords  LateRecord[]
  violations   Violation[]
  trips        TripParticipant[]
  teams        TeamMember[]
  trials       TrialCandidate[]
  achievements Achievement[]

  @@index([program, section])
  @@map("students")
}

model LateRecord {
  id             Int              @id @default(autoincrement())
  rollNo         String           @map("roll_no") @db.VarChar(20)
  // College-local calendar date of the late arrival.
  lateDate       DateTime         @map("late_date") @db.Date
  // Exact instant recorded at the gate.
  arrivedAt      DateTime         @map("arrived_at") @db.Timestamptz(3)
  minutesLate    Int              @map("minutes_late")
  reason         LateReason
  actionTaken    DisciplineAction @default(VERBAL_WARNING) @map("action_taken")
  fineAmount     Decimal          @default(0) @map("fine_amount") @db.Decimal(8, 2)
  finePaid       Boolean          @default(false) @map("fine_paid")
  finePaidAt     DateTime?        @map("fine_paid_at") @db.Timestamptz(3)
  parentNotified Boolean          @default(false) @map("parent_notified")
  remarks        String?
  recordedById   Int              @map("recorded_by")
  createdAt      DateTime         @default(now()) @map("created_at")

  student    Student @relation(fields: [rollNo], references: [rollNo], onUpdate: Cascade)
  recordedBy User    @relation(fields: [recordedById], references: [id])

  // A student can only be logged late once per day.
  @@unique([rollNo, lateDate])
  @@index([lateDate])
  @@map("late_records")
}

model User {
  id           Int      @id @default(autoincrement())
  fullName     String   @map("full_name") @db.VarChar(100)
  // Sign-in email. The column keeps its old name; accounts made before
  // email sign-in may still hold a plain username until an email is set.
  email        String   @unique @map("username") @db.VarChar(120)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  sessions    Session[]
  lateRecords LateRecord[]
  violations  Violation[]
  trips       Trip[]
  teamsAdded  TeamMember[]

  @@map("users")
}

model Session {
  // SHA-256 of the token stored in the browser cookie.
  id        String   @id @db.VarChar(64)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Single-row table (id = 1) holding the configurable portal rules.
model PortalSettings {
  id                     Int      @id @default(1)
  collegeName            String   @default("Government College") @map("college_name") @db.VarChar(150)
  collegeAddress         String   @default("") @map("college_address") @db.VarChar(255)
  timezone               String   @default("Asia/Karachi") @db.VarChar(64)
  schedule               Schedule @default(SUMMER)
  // "HH:MM" in the college timezone.
  summerStartTime        String   @default("08:00") @map("summer_start_time") @db.VarChar(5)
  winterStartTime        String   @default("08:30") @map("winter_start_time") @db.VarChar(5)
  // Evening shift start times (the two above are the morning shift).
  eveningSummerStartTime String   @default("13:30") @map("evening_summer_start_time") @db.VarChar(5)
  eveningWinterStartTime String   @default("13:00") @map("evening_winter_start_time") @db.VarChar(5)
  gracePeriodMins        Int      @default(10) @map("grace_period_mins")
  habitualThreshold      Int      @default(3) @map("habitual_threshold")
  criticalThreshold      Int      @default(5) @map("critical_threshold")
  defaultFineAmount      Decimal  @default(100) @map("default_fine_amount") @db.Decimal(8, 2)
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("portal_settings")
}

// Kinds of discipline violation, managed by the Discipline In-Charge.
model ViolationType {
  id                Int      @id @default(autoincrement())
  name              String   @unique @db.VarChar(80)
  severity          Severity @default(MINOR)
  defaultFineAmount Decimal  @default(0) @map("default_fine_amount") @db.Decimal(8, 2)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")

  violations Violation[]

  @@map("violation_types")
}

model Violation {
  id             Int             @id @default(autoincrement())
  rollNo         String          @map("roll_no") @db.VarChar(20)
  typeId         Int             @map("type_id")
  // Severity is copied from the type when recorded, so later edits to the
  // type don't rewrite history.
  severity       Severity
  // College-local calendar date of the incident.
  incidentDate   DateTime        @map("incident_date") @db.Date
  // "HH:MM" in the college timezone, if known.
  incidentTime   String?         @map("incident_time") @db.VarChar(5)
  location       String?         @db.VarChar(100)
  description    String
  reportedBy     String?         @map("reported_by") @db.VarChar(100)
  actionTaken    ViolationAction @default(VERBAL_WARNING) @map("action_taken")
  suspensionDays Int?            @map("suspension_days")
  fineAmount     Decimal         @default(0) @map("fine_amount") @db.Decimal(8, 2)
  finePaid       Boolean         @default(false) @map("fine_paid")
  finePaidAt     DateTime?       @map("fine_paid_at") @db.Timestamptz(3)
  parentNotified Boolean         @default(false) @map("parent_notified")
  status         CaseStatus      @default(OPEN)
  closedAt       DateTime?       @map("closed_at") @db.Timestamptz(3)
  closingNote    String?         @map("closing_note") @db.VarChar(300)
  recordedById   Int             @map("recorded_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  student       Student               @relation(fields: [rollNo], references: [rollNo], onUpdate: Cascade)
  type          ViolationType         @relation(fields: [typeId], references: [id])
  recordedBy    User                  @relation(fields: [recordedById], references: [id])
  // Cases recorded together for one incident share this key (null = single student).
  incidentGroup String?               @map("incident_group") @db.VarChar(36)
  attachments   ViolationAttachment[]

  @@index([incidentDate])
  @@index([incidentGroup])
  @@index([rollNo])
  @@index([status])
  @@map("violations")
}

model Trip {
  id              Int        @id @default(autoincrement())
  title           String     @db.VarChar(120)
  type            TripType   @default(STUDY_TOUR)
  destination     String     @db.VarChar(150)
  purpose         String?
  itinerary       String?
  // College-local dates and "HH:MM" times.
  departDate      DateTime   @map("depart_date") @db.Date
  departTime      String     @map("depart_time") @db.VarChar(5)
  returnDate      DateTime   @map("return_date") @db.Date
  returnTime      String     @map("return_time") @db.VarChar(5)
  meetingPoint    String?    @map("meeting_point") @db.VarChar(150)
  // Empty = open to every program.
  programs        String[]
  seats           Int?
  // Free trips keep feeAmount at 0.
  feeAmount       Decimal    @default(0) @map("fee_amount") @db.Decimal(8, 2)
  // Night-stay trips get room allocation.
  overnight       Boolean    @default(false)
  feeDeadline     DateTime?  @map("fee_deadline") @db.Date
  consentDeadline DateTime?  @map("consent_deadline") @db.Date
  inChargeName    String     @map("in_charge_name") @db.VarChar(100)
  inChargePhone   String?    @map("in_charge_phone") @db.VarChar(20)
  status          TripStatus @default(OPEN)
  departedAt      DateTime?  @map("departed_at") @db.Timestamptz(3)
  departureNote   String?    @map("departure_note") @db.VarChar(300)
  returnedAt      DateTime?  @map("returned_at") @db.Timestamptz(3)
  returnNote      String?    @map("return_note") @db.VarChar(300)
  cancelReason    String?    @map("cancel_reason") @db.VarChar(300)
  createdById     Int        @map("created_by")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  createdBy    User              @relation(fields: [createdById], references: [id])
  staff        TripStaff[]
  vehicles     TripVehicle[]
  rooms        TripRoom[]
  participants TripParticipant[]

  @@index([departDate])
  @@index([status])
  @@map("trips")
}

// Teachers and staff travelling with the students.
model TripStaff {
  id     Int     @id @default(autoincrement())
  tripId Int     @map("trip_id")
  name   String  @db.VarChar(100)
  phone  String? @db.VarChar(20)
  role   String  @db.VarChar(40)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_staff")
}

model TripVehicle {
  id          Int     @id @default(autoincrement())
  tripId      Int     @map("trip_id")
  name        String  @db.VarChar(60)
  driverName  String? @map("driver_name") @db.VarChar(100)
  driverPhone String? @map("driver_phone") @db.VarChar(20)
  seats       Int?

  trip         Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  participants TripParticipant[]

  @@index([tripId])
  @@map("trip_vehicles")
}

model TripParticipant {
  id             Int               @id @default(autoincrement())
  tripId         Int               @map("trip_id")
  rollNo         String            @map("roll_no") @db.VarChar(20)
  status         ParticipantStatus @default(REGISTERED)
  consent        ConsentStatus     @default(PENDING)
  consentAt      DateTime?         @map("consent_at") @db.Date
  feePaid        Decimal           @default(0) @map("fee_paid") @db.Decimal(8, 2)
  feePaidAt      DateTime?         @map("fee_paid_at") @db.Date
  receiptNo      String?           @map("receipt_no") @db.VarChar(30)
  medicalNotes   String?           @map("medical_notes") @db.VarChar(300)
  // Null means the parent's phone from the student record.
  emergencyPhone String?           @map("emergency_phone") @db.VarChar(20)
  vehicleId      Int?              @map("vehicle_id")
  roomId         Int?              @map("room_id")
  departedAt     DateTime?         @map("departed_at") @db.Timestamptz(3)
  returnedAt     DateTime?         @map("returned_at") @db.Timestamptz(3)
  // Enrolled despite a discipline warning (open severe violation).
  overrideNote   String?           @map("override_note") @db.VarChar(200)
  createdAt      DateTime          @default(now()) @map("created_at")

  trip    Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [rollNo], references: [rollNo], onUpdate: Cascade)
  vehicle TripVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  room    TripRoom?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([tripId, rollNo])
  @@index([rollNo])
  @@map("trip_participants")
}

// Rooms for night-stay trips.
model TripRoom {
  id     Int     @id @default(autoincrement())
  tripId Int     @map("trip_id")
  name   String  @db.VarChar(60)
  beds   Int
  // Hotel / hostel / building and floor.
  place  String? @db.VarChar(100)
  notes  String? @db.VarChar(200)

  trip         Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  participants TripParticipant[]

  @@index([tripId])
  @@map("trip_rooms")
}

model Sport {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(60)
  coach     String?  @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  teams  Team[]
  trials Trial[]

  @@map("sports")
}

// A college sports event, e.g. "Annual Sports Week 2026".
model SportsEvent {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  venue     String?  @db.VarChar(100)
  notes     String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")

  teams Team[]

  @@index([startDate])
  @@map("sports_events")
}

// The college's team in one sport of one event.
model Team {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  sportId   Int      @map("sport_id")
  // Team manager / coach.
  manager   String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  event        SportsEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sport        Sport         @relation(fields: [sportId], references: [id])
  members      TeamMember[]
  achievements Achievement[]

  @@unique([eventId, sportId])
  @@map("teams")
}

model TeamMember {
  id           Int           @id @default(autoincrement())
  teamId       Int           @map("team_id")
  rollNo       String        @map("roll_no") @db.VarChar(20)
  // "Captain", "Vice-captain" or "Player"
  role         String        @default("Player") @db.VarChar(20)
  jerseyNo     Int?          @map("jersey_no")
  position     String?       @db.VarChar(40)
  status       MemberStatus  @default(SELECTED)
  medicalNote  String?       @map("medical_note") @db.VarChar(300)
  consent      ConsentStatus @default(PENDING)
  overrideNote String?       @map("override_note") @db.VarChar(200)
  addedById    Int           @map("added_by")
  createdAt    DateTime      @default(now()) @map("created_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [rollNo], references: [rollNo], onUpdate: Cascade)
  addedBy User    @relation(fields: [addedById], references: [id])

  @@unique([teamId, rollNo])
  @@index([rollNo])
  @@map("team_members")
}

model Trial {
  id        Int      @id @default(autoincrement())
  sportId   Int      @map("sport_id")
  trialDate DateTime @map("trial_date") @db.Date
  venue     String?  @db.VarChar(100)
  notes     String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")

  sport      Sport            @relation(fields: [sportId], references: [id])
  candidates TrialCandidate[]

  @@index([trialDate])
  @@map("trials")
}

model TrialCandidate {
  id      Int         @id @default(autoincrement())
  trialId Int         @map("trial_id")
  rollNo  String      @map("roll_no") @db.VarChar(20)
  result  TrialResult @default(PENDING)
  note    String?     @db.VarChar(200)

  trial   Trial   @relation(fields: [trialId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [rollNo], references: [rollNo], onUpdate: Cascade)

  @@unique([trialId, rollNo])
  @@map("trial_candidates")
}

model Achievement {
  id         Int      @id @default(autoincrement())
  // A student, a team, or both (a medal won by a team member).
  rollNo     String?  @map("roll_no") @db.VarChar(20)
  teamId     Int?     @map("team_id")
  event      String   @db.VarChar(120)
  position   String   @db.VarChar(60)
  achievedOn DateTime @map("achieved_on") @db.Date
  notes      String?  @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at")

  student Student? @relation(fields: [rollNo], references: [rollNo], onUpdate: Cascade)
  team    Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([rollNo])
  @@map("achievements")
}

// A class section (CD1, CD 54…). Created first, then students are placed in it.
model Section {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(20)
  year      StudyYear?
  // Students take the shift (and so the start time) of their section.
  shift     Shift      @default(MORNING)
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("sections")
}

// A program / group offered by the college (Medical, ICS, DIT, I.Com, FA…).
model Program {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("programs")
}

// A file kept with a violation case: the student's application, an undertaking,
// a parent letter… Stored in the database so no extra storage service is needed.
model ViolationAttachment {
  id          Int      @id @default(autoincrement())
  violationId Int      @map("violation_id")
  fileName    String   @map("file_name") @db.VarChar(200)
  mimeType    String   @map("mime_type") @db.VarChar(100)
  size        Int
  data        Bytes
  note        String?  @db.VarChar(200)
  uploadedBy  String   @map("uploaded_by") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")

  violation Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)

  @@index([violationId])
  @@map("violation_attachments")
}
